# Copy to api/.env for local runs. Every value can also be a real env var.
ENVIRONMENT=dev

# Postgres from docker-compose (host port 5433). SQLite works too: sqlite:///./data/voix.sqlite3
DATABASE_URL=postgresql+psycopg://voix:voix@localhost:5433/voix

# Required in production (the API refuses to start with the dev defaults).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-jwt-secret-change-me
WORKER_TOKEN=dev-insecure-worker-token

# Storage: local (dev) or s3 (any S3-compatible store, e.g. Cloudflare R2)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=data/storage
# S3_BUCKET=voix
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ENABLED_ENGINES=kokoro,xtts
CLONE_ENGINE=xtts

# Limits
RATE_LIMIT_JOBS_PER_MINUTE=10
MAX_TEXT_CHARS=5000
MAX_UPLOAD_MB=20
LEASE_SECONDS=60

# Observability
LOG_FORMAT=json          # or text
LOG_LEVEL=INFO
# METRICS_TOKEN=          # if set, /metrics requires "Authorization: Bearer <token>"
