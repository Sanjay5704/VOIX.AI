# Copy this file to .env and adjust as needed.

# --- General ---
APP_NAME=XTTS Production TTS API
ENVIRONMENT=development
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Paths (defaults are relative to backend/, override if needed) ---
# VOICES_DIR=./voices
# OUTPUTS_DIR=./outputs
# UPLOADS_DIR=./uploads
# LOGS_DIR=./logs
# MODEL_CACHE_DIR=./model_cache

# --- TTS Engine ---
TTS_MODEL_NAME=tts_models/multilingual/multi-dataset/xtts_v2
# auto | cuda | cpu
DEVICE_PREFERENCE=auto
USE_FP16=true
DEFAULT_LANGUAGE=en

# --- Engines ---
# kokoro = fast, free to use (Apache-2.0). xtts = voice cloning (non-commercial licence).
ENABLED_ENGINES=kokoro,xtts
DEFAULT_VOICE=af_heart

# --- Generation limits ---
MAX_TEXT_LENGTH=100000
MAX_BATCH_ITEMS=100
MAX_UPLOAD_MB=30
GENERATION_TIMEOUT_SECONDS=5000

# --- Audio ---
OUTPUT_SAMPLE_RATE=24000
AUDIO_RETENTION_HOURS=24

# --- Concurrency ---
# Number of simultaneous generations allowed. Keep at 1 on consumer GPUs
# to avoid VRAM contention; can raise on multi-GPU / high-VRAM servers.
MAX_CONCURRENT_GENERATIONS=1

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Coqui TTS license auto-accept (required non-interactively) ---
COQUI_TOS_AGREED=1
