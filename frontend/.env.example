# Base URL the React app uses to reach the FastAPI backend.
# In dev, the Vite proxy (vite.config.js) forwards /api to this target,
# so VITE_API_BASE_URL can usually stay empty (relative requests).
# In production builds served separately from the API, set the full URL:
# VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=
