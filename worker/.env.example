# Copy to worker/.env. The worker only makes outbound HTTPS calls to API_URL.
API_URL=http://localhost:8000
WORKER_TOKEN=dev-insecure-worker-token
WORKER_NAME=rtx4070-laptop

# kokoro,xtts on the GPU; "mock" runs anywhere without model downloads
ENGINES=kokoro,xtts
DEVICE=auto

CACHE_DIR=cache
POLL_WAIT_SECONDS=10
HEARTBEAT_INTERVAL_SECONDS=15
